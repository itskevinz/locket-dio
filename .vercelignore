# Huy Locket now runs the Express backend on Vercel.
# Keep runtime backend source and package manifests available to the function tracer.

# Backend-only files not needed at runtime
api/test
api/tests
api/node_modules
api/.dockerignore
api/.env.example
api/.gitignore
api/DEPLOY.md
api/docker-compose*
api/Dockerfile
api/install_ffmpeg.sh
api/nginx.conf
api/railway.toml
api/README.md
api/render.yaml
api/SECURITY.md
api/START-API.bat

# Root deployment files not used by Vercel runtime
server.mjs
Dockerfile
Dockerfile.api
railway.toml
render.yaml
fly.toml
firebase.json

# Unneeded root-level project data
/apps
/_upgrade_backup_20260710172600
/public_legacy_locket
/data
/node_modules
/dist

# Vercel runs npm run build:deploy, so src/ and public/ must be uploaded.
# The leading slash on /data keeps nested source folders such as
# src/features/CustomeStudio/data available to Vite.
