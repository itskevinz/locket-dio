{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "functions": {
    "api/vercel-web.js": {
      "includeFiles": "google/**",
      "maxDuration": 60
    },
    "api/socket-io.js": {
      "includeFiles": "google/**",
      "maxDuration": 60
    },
    "api/telegram-update.js": {
      "includeFiles": "google/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/telegram-webhook",
      "destination": "/api/telegram-update"
    },
    {
      "source": "/(.*)",
      "destination": "/api/vercel-web?__path=/$1"
    }
  ]
}
