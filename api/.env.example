# ==================================================
# SERVER
# ==================================================

# Port server chạy (Express / Fastify / HTTP)
PORT=5004

# Neon/Postgres pooled connection string (server runtime only)
DATABASE_URL=

# Celebrity catalog: tự đồng bộ nguồn chính mỗi 5 phút. Có thể nối thêm tối đa
# 8 nguồn JSON HTTPS đã xác minh, phân cách bằng dấu phẩy hoặc xuống dòng.
# DIO_CELEBRITY_CATALOG_URL=https://data.locket-dio.com/v1/public/getAllCelebrateV2
# CELEBRITY_CATALOG_URLS=https://example.com/verified-celebrities.json
# CELEBRITY_SYNC_INTERVAL_MS=300000

# ================== SUPABASE ==================

# Base URL của Supabase project
SUPABASE_URL=

# Service Role Key (⚠️ quyền cao nhất – CHỈ dùng ở server)
SUPABASE_SERVICE_ROLE_KEY=


# ================== WEB PUSH (VAPID) ==================

# Optional override cho Web Push. Nếu để trống và DATABASE_URL có sẵn,
# Canh Slot 24/7 sẽ tự tạo một cặp VAPID rồi lưu bền trong Postgres.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:buiduchuy2010qn@gmail.com

# Optional secret riêng để mã hóa refresh token Canh Slot 24/7 tại rest.
# Nếu bỏ trống, server dùng COOKIE_SECRET/JWT_SECRET/LOCKETDIO_JWT_SECRET.
# Production nên đặt chuỗi ngẫu nhiên dài >= 32 ký tự nếu muốn tách khóa riêng.
SLOT_MONITOR_ENCRYPTION_KEY=

# URL web dùng trong nút mở từ Telegram/Gmail/Zalo.
PUBLIC_WEB_URL=https://duchi.vercel.app

# ================== SLOT NOTIFICATIONS ==================

# Telegram Bot API. Tạo bot bằng BotFather; token chỉ để ở Railway Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Gmail thật qua Google Apps Script Web App (HTTPS).
# Railway Trial/Free/Hobby chặn outbound SMTP nên KHÔNG dùng smtp.gmail.com ở đây.
# Deploy Apps Script bằng tài khoản Gmail gửi mail, rồi đặt URL /exec và secret tại Railway.
GMAIL_APPS_SCRIPT_URL=
GMAIL_APPS_SCRIPT_SECRET=
GMAIL_FROM_NAME=Duchi Locket

# Zalo Official Account API V3.
ZALO_OA_ACCESS_TOKEN=
# Optional override; mặc định https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_OA_MESSAGE_URL=


# ================== THIRD-PARTY API ==================

# API key cho dịch vụ thời tiết (ví dụ: OpenWeather, WeatherAPI…)
WEATHER_API_KEY=


# ================== REDIS ==================

# Connection string Redis (cache, queue, socket adapter…)
REDIS_URL=


# ================== INTERNAL API BY DIO ==================

# API nội bộ hoặc storage service riêng (upload, CDN, media…)
STORAGE_API_URL=
# Secret dùng để ký & verify cookie (session token…)
COOKIE_SECRET=
LOCKETDIO_JWT_SECRET=
# Bắt buộc cho JWT PIN/2FA Admin; chỉ dùng phía server, tối thiểu 32 ký tự.
JWT_SECRET=
# Danh tính bootstrap Admin, phân tách bằng dấu phẩy/khoảng trắng.
# Production phải cấu hình ít nhất một trong hai biến này.
ADMIN_LOCKET_UIDS=
ADMIN_LOCKET_EMAILS=

# ================== SETTING APP API BY DIO ==================
# upload tổng tối đa (MB)
MAX_UPLOAD_SIZE=150

# video tối đa (MB)
MAX_VIDEO_SIZE_MB=6

# user free tối đa (MB)
MAX_SIZE_ALLOWED_FREE=15

# ảnh tối đa (MB)
MAX_IMAGE_SIZE=5

# ================== LOCKET ==================

# Base API của Locket (reverse / private API)
LOCKET_API_BASE=https://api.locketcamera.com


# ================== FIREBASE ==================

# API Key Firebase (Auth, AppCheck, Identity Toolkit…)
FIREBASE_API_KEY=

# Firebase Authentication (Identity Toolkit API)
# Dùng cho: signIn, signUp, verifyPhoneNumber, refresh token...
FIREBASE_AUTH_API_BASE=https://www.googleapis.com/identitytoolkit/v3/relyingparty

# Firebase Firestore REST API base
# Dùng cho: đọc/ghi document qua REST
FIREBASE_FIRESTORE_API_BASE=https://firestore.googleapis.com/v1/projects/locket-4252a/databases

# Firebase App Check API
# Dùng cho: verify / exchange App Check token
FIREBASE_APPCHECK_API_BASE=https://firebaseappcheck.googleapis.com

LOCKET_APP_CHECK_DEVICE_TOKEN=
LOCKET_APP_CHECK_DEVICE_ID=1:641029076083:ios:cc8eb46290d69b234fa606

# Firebase Secure Token API
# Dùng cho: refresh access token từ refresh token
FIREBASE_SECURETOKEN_API_BASE=https://securetoken.googleapis.com

# Proxy
# Dùng cho: gọi các api qua proxy
LOCKET_HTTP_PROXY=
# Spotify Web API (server-side client credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Locket optional protocol tokens
LOCKET_CLIENT_TOKEN=
LOCKET_APP_CHECK_TOKEN=
LOCKET_FCM_INSTANCE_ID_TOKEN=
LOCKETDIO_SIGNATURE_SECRET=

# ================== ACCOUNT DRAFT SYNC ==================
# Durable private media + metadata on API disk (NOT os.tmpdir).
# On Railway: mount a Volume and point this to the mount path, e.g. /data/huy-locket-drafts
# Paths: {DRAFT_MEDIA_DIR}/drafts/{ownerUid}/{draftId}/{original|active|thumbnail}
#        {DRAFT_MEDIA_DIR}/meta/{ownerUid}.json
DRAFT_MEDIA_DIR=
# Max upload size bytes (default ~95MB)
DRAFT_MAX_BYTES=
# Signed media URL TTL ms (default 15 minutes)
DRAFT_SIGN_TTL_MS=
# Upload rate limit per user / 15 min (default 60)
DRAFT_UPLOAD_RATE_MAX=
# Public base for signed absolute URLs (optional; falls back to request host)
PUBLIC_API_URL=
