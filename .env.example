# API gốc
VITE_BASE_API_URL=https://api.locket-dio.com
# API phụ
VITE_DATABASE_API_URL=https://data.locket-dio.com

# Api dịch vụ lưu trữ ảnh/video
VITE_STORAGE_API_URL=https://storage.locket-dio.com
VITE_MEDIA_API_URL=https://media.locket-dio.com
#API băng thông cdn
VITE_CDN_URL=https://cdn.locket-dio.com

# API socket client
VITE_CHAT_SERVER_URL=chat.locket-dio.com

VITE_LOCKET_API_URL=https://api.locketcamera.com

# API tiện ích mở rộng
VITE_EXPORTS_API_URL=https://export.locket-dio.com

# VAPID Key for Web Push Notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Key captcha Cloudflare
VITE_TURNSTILE_SITE_KEY=

# Cloudflare R2 riêng cho media trung gian của Huy Locket (API server only)
# Tạo R2 bucket + API token Object Read & Write, rồi đặt các biến này trên Render/Railway.
# Không thêm các secret này vào VITE_* hoặc commit giá trị thật lên GitHub.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=huy-locket-media
# Optional: mặc định https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional: mặc định huy-locket/temp
R2_PREFIX=huy-locket/temp
R2_REGION=auto

# Shared Google Drive (1 Drive cho cả web — chỉ admin Gmail thấy UI)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=1abcFolderId
# ADMIN_EMAILS=buiduchuy2010qn@gmail.com
# VITE_ADMIN_EMAILS=buiduchuy2010qn@gmail.com

# Spotify user OAuth (caption Nhạc live) — Client ID từ developer.spotify.com
# Redirect URI bắt buộc: https://YOUR-DOMAIN/spotify/callback
# VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Spotify Web API official (API server — full isrc + meta khi dán link track)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=


PUBLIC_API_KEY=WS&&HELLOLOCKETDIO2523&&SW
